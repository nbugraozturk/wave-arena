{
  "name": "wave-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test src/core/**/*.test.ts",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "balance:report": "node --import tsx scripts/balance-report.ts",
    "replay:fixture": "node --import tsx scripts/replay-fixture.ts",
    "replay:fixture:update": "node --import tsx scripts/replay-fixture.ts --update",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^5.4.19"
  }
}
